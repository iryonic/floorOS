<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Block access to hidden files (.env, .git, etc.) except .well-known
    RewriteRule ^\.(?!well-known).* - [F,L]

    # 2. Block direct access to internal Laravel directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)($|/) - [F,L]

    # 3. Block sensitive root configuration and manifest files
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|\.env.*)$ - [F,L]

    # 4. Redirect trailing slashes if not a directory
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 5. Route all requests into the /public/ directory
    RewriteCond %{REQUEST_URI} !/public/ [NC]
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Security: Deny direct HTTP access to configuration and environment files
<FilesMatch "^\.env|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|\.git">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Proper MIME types for PWA manifest and modern assets
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest .json
    AddType text/javascript .js
    AddType image/webp .webp
    AddType image/svg+xml .svg
</IfModule>
